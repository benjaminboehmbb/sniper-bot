{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcc002:schema:review-manifest:1.0.0",
  "title": "RCC-002 Review Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_id",
    "manifest_schema_version",
    "manifest_schema_ref",
    "manifest_type",
    "manifest_id",
    "created_at_utc",
    "producer",
    "project",
    "status",
    "subject_dataset_manifest_id",
    "subject_dataset_manifest_byte_sha256",
    "review_id",
    "review_type",
    "reviewer",
    "reviewer_system",
    "reviewed_artifacts",
    "started_at_utc",
    "completed_at_utc",
    "review_status",
    "findings",
    "resolution_references"
  ],
  "properties": {
    "manifest_schema_id": {
      "const": "rcc002.review-manifest"
    },
    "manifest_schema_version": {
      "const": "1.0.0"
    },
    "manifest_schema_ref": {
      "const": "rcc002.review-manifest/1.0.0"
    },
    "manifest_type": {
      "const": "review"
    },
    "manifest_id": {
      "$ref": "#/$defs/manifest_id"
    },
    "created_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "project": {
      "const": "RCC-002"
    },
    "status": {
      "enum": [
        "candidate",
        "final",
        "withdrawn"
      ]
    },
    "subject_dataset_manifest_id": {
      "$ref": "#/$defs/manifest_id"
    },
    "subject_dataset_manifest_byte_sha256": {
      "$ref": "#/$defs/digest"
    },
    "review_id": {
      "type": "string",
      "minLength": 1,
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "review_type": {
      "enum": [
        "internal",
        "scr",
        "architecture",
        "editorial",
        "certification",
        "external",
        "consolidation"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "reviewer_system": {
      "enum": [
        "human",
        "chatgpt",
        "gemini",
        "claude",
        "other"
      ]
    },
    "reviewed_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reviewed_artifact"
      }
    },
    "started_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "completed_at_utc": {
      "anyOf": [
        {
          "$ref": "#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_status": {
      "enum": [
        "pending",
        "passed",
        "passed_with_findings",
        "failed"
      ]
    },
    "review_artifact_relative_path": {
      "$ref": "#/$defs/portable_path"
    },
    "review_artifact_byte_sha256": {
      "$ref": "#/$defs/digest"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "status",
          "summary"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "type": "string",
              "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
            }
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR",
              "NOTE"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "CLOSED",
              "ACCEPTED_LIMITATION"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "not": {
              "type": "string",
              "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
            }
          }
        }
      }
    },
    "resolution_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewed_artifact"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewer_system": {
            "enum": [
              "claude",
              "gemini"
            ]
          },
          "review_status": {
            "enum": [
              "passed",
              "passed_with_findings"
            ]
          }
        },
        "required": [
          "reviewer_system",
          "review_status"
        ]
      },
      "then": {
        "required": [
          "review_artifact_relative_path",
          "review_artifact_byte_sha256"
        ],
        "properties": {
          "reviewed_artifacts": {
            "type": "array",
            "minItems": 1
          },
          "completed_at_utc": {
            "$ref": "#/$defs/utc_timestamp"
          }
        }
      }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^manifest:sha256:[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "password|secret|token|private[_-]?key"
          },
          "allOf": [
            {
              "not": {
                "type": "string",
                "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
              }
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        }
      }
    },
    "reviewed_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "byte_sha256"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/portable_path"
        },
        "byte_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    }
  }
}
