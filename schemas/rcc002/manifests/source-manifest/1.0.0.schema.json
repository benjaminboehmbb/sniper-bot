{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcc002:schema:source-manifest:1.0.0",
  "title": "RCC-002 Source Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_id",
    "manifest_schema_version",
    "manifest_schema_ref",
    "manifest_type",
    "manifest_id",
    "created_at_utc",
    "producer",
    "project",
    "status",
    "source_snapshot_id",
    "source_snapshot_preimage_sha256",
    "source_retrieval_profile_id",
    "source_retrieval_profile_version",
    "source_row_id_profile_id",
    "source_row_id_profile_version",
    "provider",
    "market_type",
    "dataset_kind",
    "symbol",
    "interval",
    "column_profile_id",
    "timestamp_unit_profile_id",
    "source_revision",
    "retrieved_at_utc",
    "source_files",
    "actual_coverage",
    "coverage_reconciliation",
    "license_or_terms_ref"
  ],
  "properties": {
    "manifest_schema_id": {
      "const": "rcc002.source-manifest"
    },
    "manifest_schema_version": {
      "const": "1.0.0"
    },
    "manifest_schema_ref": {
      "const": "rcc002.source-manifest/1.0.0"
    },
    "manifest_type": {
      "const": "source"
    },
    "manifest_id": {
      "$ref": "#/$defs/manifest_id"
    },
    "created_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "project": {
      "const": "RCC-002"
    },
    "status": {
      "enum": [
        "candidate",
        "published",
        "superseded",
        "withdrawn"
      ]
    },
    "source_snapshot_id": {
      "type": "string",
      "pattern": "^source:sha256:[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "source_snapshot_preimage_sha256": {
      "$ref": "#/$defs/digest"
    },
    "source_retrieval_profile_id": {
      "const": "RCC002_BINANCE_VISION_SPOT_KLINES_V1"
    },
    "source_retrieval_profile_version": {
      "const": "1.0.0"
    },
    "source_row_id_profile_id": {
      "const": "RCC002_S1_SOURCE_ROW_ID_V2"
    },
    "source_row_id_profile_version": {
      "const": "2.0.0"
    },
    "provider": {
      "const": "BINANCE_VISION"
    },
    "market_type": {
      "const": "spot"
    },
    "dataset_kind": {
      "const": "klines"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]+$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "interval": {
      "const": "1m"
    },
    "column_profile_id": {
      "const": "BINANCE_SPOT_KLINE_12_COLUMN_V1"
    },
    "timestamp_unit_profile_id": {
      "const": "BINANCE_SPOT_TIMESTAMP_UNITS_V1"
    },
    "source_revision": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "retrieved_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "source_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_file"
      }
    },
    "actual_coverage": {
      "$ref": "#/$defs/coverage"
    },
    "coverage_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exceptions"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "PASS_WITH_REGISTERED_EXCEPTIONS",
            "FAIL"
          ]
        },
        "exceptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "type": "string",
              "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
            }
          }
        }
      }
    },
    "license_or_terms_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^manifest:sha256:[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "password|secret|token|private[_-]?key"
          },
          "allOf": [
            {
              "not": {
                "type": "string",
                "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
              }
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        }
      }
    },
    "archive_period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_family",
        "period_token",
        "period_start_utc",
        "period_end_utc"
      ],
      "properties": {
        "archive_family": {
          "enum": [
            "DAILY",
            "MONTHLY"
          ]
        },
        "period_token": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}(?:-[0-9]{2})?$",
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        },
        "period_start_utc": {
          "$ref": "#/$defs/utc_timestamp"
        },
        "period_end_utc": {
          "$ref": "#/$defs/utc_timestamp"
        }
      }
    },
    "source_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_relative_name",
        "byte_sha256",
        "provider_checksum_sha256",
        "size_bytes",
        "csv_member_name",
        "source_file_ordinal",
        "archive_period",
        "record_count",
        "min_open_time_utc_ms",
        "max_close_time_utc_ms",
        "timestamp_unit"
      ],
      "properties": {
        "provider_relative_name": {
          "$ref": "#/$defs/portable_path"
        },
        "byte_sha256": {
          "$ref": "#/$defs/digest"
        },
        "provider_checksum_sha256": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "csv_member_name": {
          "$ref": "#/$defs/portable_path"
        },
        "source_file_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99999999
        },
        "archive_period": {
          "$ref": "#/$defs/archive_period"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        },
        "min_open_time_utc_ms": {
          "type": "integer"
        },
        "max_close_time_utc_ms": {
          "type": "integer"
        },
        "timestamp_unit": {
          "enum": [
            "MILLISECOND",
            "MICROSECOND"
          ]
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_open_time_utc_ms",
        "max_close_time_utc_ms",
        "record_count"
      ],
      "properties": {
        "min_open_time_utc_ms": {
          "type": "integer"
        },
        "max_close_time_utc_ms": {
          "type": "integer"
        },
        "record_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "$comment": "Semantic validation enforces canonical portable-name ordering, zero-based contiguous ordinals, provider checksum equality, coverage reconciliation, and the exact Source Snapshot V1 preimage."
}
