{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rcc002:schema:run-manifest:1.0.0",
  "title": "RCC-002 Run Manifest 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_schema_id",
    "manifest_schema_version",
    "manifest_schema_ref",
    "manifest_type",
    "manifest_id",
    "created_at_utc",
    "producer",
    "project",
    "status",
    "run_id",
    "build_id",
    "started_at_utc",
    "ended_at_utc",
    "code_provenance",
    "environment",
    "execution_parameters",
    "validation_outcome",
    "publication_outcome"
  ],
  "properties": {
    "manifest_schema_id": {
      "const": "rcc002.run-manifest"
    },
    "manifest_schema_version": {
      "const": "1.0.0"
    },
    "manifest_schema_ref": {
      "const": "rcc002.run-manifest/1.0.0"
    },
    "manifest_type": {
      "const": "run"
    },
    "manifest_id": {
      "$ref": "#/$defs/manifest_id"
    },
    "created_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "project": {
      "const": "RCC-002"
    },
    "status": {
      "enum": [
        "running",
        "candidate",
        "published",
        "failed",
        "quarantined"
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^run:.+$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "build_id": {
      "type": "string",
      "pattern": "^build:sha256:[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "started_at_utc": {
      "$ref": "#/$defs/utc_timestamp"
    },
    "ended_at_utc": {
      "anyOf": [
        {
          "$ref": "#/$defs/utc_timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "code_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit_sha",
        "worktree_clean",
        "dirty_patch_sha256",
        "entrypoint"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        },
        "worktree_clean": {
          "type": "boolean"
        },
        "dirty_patch_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "entrypoint": {
          "$ref": "#/$defs/portable_path"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_identity_profile_id",
        "environment_identity_sha256",
        "python_version",
        "lockfile_relative_path",
        "lockfile_byte_sha256",
        "platform",
        "libraries"
      ],
      "properties": {
        "environment_identity_profile_id": {
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        },
        "environment_identity_sha256": {
          "$ref": "#/$defs/digest"
        },
        "python_version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        },
        "lockfile_relative_path": {
          "$ref": "#/$defs/portable_path"
        },
        "lockfile_byte_sha256": {
          "$ref": "#/$defs/digest"
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        },
        "libraries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "version"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "type": "string",
                  "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
                }
              },
              "version": {
                "type": "string",
                "minLength": 1,
                "not": {
                  "type": "string",
                  "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
                }
              }
            }
          }
        }
      }
    },
    "execution_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_build_configuration_sha256",
        "physical_publication_configuration_sha256",
        "effective_cli_arguments"
      ],
      "properties": {
        "semantic_build_configuration_sha256": {
          "$ref": "#/$defs/digest"
        },
        "physical_publication_configuration_sha256": {
          "$ref": "#/$defs/digest"
        },
        "effective_cli_arguments": {
          "type": "array",
          "items": {
            "type": "string",
            "not": {
              "pattern": "password|secret|token|private[_-]?key"
            },
            "allOf": [
              {
                "not": {
                  "type": "string",
                  "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
                }
              }
            ]
          }
        }
      }
    },
    "validation_outcome": {
      "$ref": "#/$defs/outcome"
    },
    "publication_outcome": {
      "$ref": "#/$defs/outcome"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^manifest:sha256:[0-9a-f]{64}$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "portable_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$",
      "not": {
        "type": "string",
        "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "version"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "password|secret|token|private[_-]?key"
          },
          "allOf": [
            {
              "not": {
                "type": "string",
                "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
              }
            }
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "type": "string",
            "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason_codes"
      ],
      "properties": {
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_ATTEMPTED",
            "QUARANTINED"
          ]
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "not": {
              "type": "string",
              "pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee][_-]?[Kk][Ee][Yy]"
            }
          }
        }
      }
    }
  }
}
